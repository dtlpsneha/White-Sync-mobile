{
    "cli": {
        "version": ">= 16.28.0"
    },
    "build": {
        "development": {
            "channel": "development",
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "image": "latest"
            }
        },
        "preview": {
            "channel": "preview",
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "image": "latest"
            },
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
            }
        },
        "production": {
            "channel": "production",
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
            }
        }
    },
    "submit": {
        "production": {}
    }
}