<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Higher priority than expo-notifications' own FCM service (-1), so this
             one receives the push and defers to it for everything it doesn't handle. -->
        <service
            android:name="expo.modules.floatingnotifications.QuotationMessagingService"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
